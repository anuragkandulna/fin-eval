DOMAIN=localhost
ENVIRONMENT=local
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Database (Azure SQL / local SQL Server) ──────────────────────────────────
# Local dev: mssql://sa:password@localhost:1433/fineval_db
# Azure:     mssql://admin:password@<server>.database.windows.net:1433/<db>
# database.py builds the ODBC string automatically from this URL.
DB_USER=fineval_admin
DB_PASSWORD=change_me
DATABASE_URL=mssql://fineval_admin:change_me@localhost:1433/fineval_db
# ──────────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Local:  QDRANT_URL=http://localhost:6333  (leave QDRANT_API_KEY empty)
# Cloud:  QDRANT_URL=https://<cluster>.cloud.qdrant.io  + QDRANT_API_KEY=<key>
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finance_docs
QDRANT_API_KEY=
# ──────────────────────────────────────────────────────────────────────────────

LOCUST_P95_MS=20000
