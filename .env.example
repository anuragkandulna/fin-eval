DOMAIN=localhost
ENVIRONMENT=local
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Database (Azure SQL / local SQL Server) ──────────────────────────────────
# Local dev: mssql://sa:password@localhost:1433/fineval_db
# Azure:     mssql://admin:password@<server>.database.windows.net:1433/<db>
# database.py builds the ODBC string automatically from this URL.
DB_USER=fineval_admin
DB_PASSWORD=change_me
DATABASE_URL=mssql://fineval_admin:change_me@localhost:1433/fineval_db
# ──────────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Local:  QDRANT_URL=http://localhost:6333  (leave QDRANT_API_KEY empty)
# Cloud:  QDRANT_URL=https://<cluster>.cloud.qdrant.io  + QDRANT_API_KEY=<key>
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finance_docs
QDRANT_API_KEY=
# ──────────────────────────────────────────────────────────────────────────────

MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=fineval

# ─── Langfuse (optional — leave empty to disable tracing) ────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3002
# ──────────────────────────────────────────────────────────────────────────────

GITHUB_REPO=your-username/fin-eval
GITHUB_TOKEN=ghp_your_token_here

FAITHFULNESS_THRESHOLD=0.70
HALLUCINATION_THRESHOLD=0.30
TOOL_ACCURACY_THRESHOLD=0.90
RELEVANCY_THRESHOLD=0.75
LOCUST_P95_MS=5000
LIGHTHOUSE_PERF_MIN=70
