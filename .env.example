DOMAIN=localhost
ENVIRONMENT=local
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Database (Neon serverless PostgreSQL) ────────────────────────────────────
# Copy the connection string from the Neon dashboard → your project → Connection Details.
# Format: postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
# ──────────────────────────────────────────────────────────────────────────────

REDIS_URL=redis://localhost:6379

# ─── Qdrant ───────────────────────────────────────────────────────────────────
# Local:  QDRANT_URL=http://localhost:6333  (leave QDRANT_API_KEY empty)
# Cloud:  QDRANT_URL=https://<cluster>.cloud.qdrant.io  + QDRANT_API_KEY=<key>
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=finance_docs
QDRANT_API_KEY=
# ──────────────────────────────────────────────────────────────────────────────

LOCUST_P95_MS=20000
